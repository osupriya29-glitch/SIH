# Operational Mode: demo | live
ORCA_MODE=demo

# LLM Provider: gemini | openai | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# System Limits & Defaults
ORCA_MAX_CANDIDATES=5
ORCA_DEFAULT_VESSEL_SPEED_KMH=15

# Live API Endpoints (optional - used when ORCA_MODE=live)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
