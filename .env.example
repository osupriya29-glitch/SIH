# Copy to .env and adjust as needed.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Phase 2
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ocean_agentic_ai
DB_ECHO=false

# Phase 3 — Auth. Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Phase 4 — IMD. Auth mechanism unconfirmed — see comment in app/core/config.py.
# Leave IMD_API_KEY unset unless IMD's dashboard says otherwise; the server's
# IP likely needs to be whitelisted via https://api.imd.gov.in instead.
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_API_KEY_HEADER=Authorization
IMD_REQUEST_TIMEOUT_SECONDS=10

# Phase 5 — Open-Meteo Marine. Free tier, no key required (non-commercial use).
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_API_KEY=
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=10

# Phase 6 — NASA Ocean Color (OB.DAAC). File search needs no login; appkey
# is only for restricted data. See app/core/config.py for why point-value
# extraction (e.g. chlorophyll at a coordinate) is not implemented yet.
NASA_OCEAN_COLOR_FILE_SEARCH_URL=https://oceandata.sci.gsfc.nasa.gov/file_search
NASA_OCEAN_COLOR_APPKEY=
NASA_OCEAN_COLOR_REQUEST_TIMEOUT_SECONDS=15

# Phase 7 — NOAA CO-OPS, NOAA/NDBC, NOAA Weather (api.weather.gov). No keys needed.
# NWS asks for a real identifying User-Agent — set your own contact info.
NOAA_COOPS_BASE_URL=https://api.tidesandcurrents.noaa.gov/api/prod/datagetter
NOAA_COOPS_REQUEST_TIMEOUT_SECONDS=10
NOAA_NDBC_BASE_URL=https://www.ndbc.noaa.gov/data/realtime2
NOAA_NDBC_REQUEST_TIMEOUT_SECONDS=10
NOAA_WEATHER_BASE_URL=https://api.weather.gov
NOAA_WEATHER_USER_AGENT=OceanAgenticAI-SIH2026 (set-a-real-contact-email@example.com)
NOAA_WEATHER_REQUEST_TIMEOUT_SECONDS=10

# Phase 8 — TidesAtlas. Requires a real API key (free tier: 50 one-time
# credits, no card). Get one at https://tidesatlas.com/api/register.
TIDESATLAS_BASE_URL=https://tidesatlas.com/api/v1
TIDESATLAS_API_KEY=
TIDESATLAS_REQUEST_TIMEOUT_SECONDS=10
